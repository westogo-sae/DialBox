<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor/DialBoxEditor.uss?fileID=7433441132597879392&amp;guid=83e1d228e3aafa9afb9fe0f628c3ea74&amp;type=3#DialBoxEditor" />
    <ui:VisualElement name="header" style="flex-grow: 0; height: 40px; flex-basis: auto; position: relative; flex-direction: row; flex-shrink: 1; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(31, 33, 38); padding-bottom: 2px; padding-top: 2px;">
        <ui:VisualElement name="buffer" class="bar-element" style="flex-grow: 1;" />
        <ui:Button text="Rebuild" name="rebuild-button" class="bar-button" />
    </ui:VisualElement>
    <ui:VisualElement name="working-area" style="flex-grow: 1; flex-direction: row; background-color: rgb(52, 50, 60); height: 800px;">
        <ui:VisualElement name="tools" class="drawer-default" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; flex-grow: 0; width: 200px;">
            <ui:VisualElement name="inspector" class="drawer-default" style="flex-grow: 1;" />
            <ui:VisualElement name="cellBank" class="drawer-default" style="flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="grid" style="flex-grow: 1;" />
    </ui:VisualElement>
</ui:UXML>
