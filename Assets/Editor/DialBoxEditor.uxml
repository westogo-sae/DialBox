<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="cell-default" src="project://database/Assets/Editor/VisualTreeAssets/cell-default.uxml?fileID=9197481963319205126&amp;guid=c9baf460b5cfce4cea8eba02bbeae97c&amp;type=3#cell-default" />
    <Style src="project://database/Assets/Editor/DialBoxEditor.uss?fileID=7433441132597879392&amp;guid=83e1d228e3aafa9afb9fe0f628c3ea74&amp;type=3#DialBoxEditor" />
    <ui:VisualElement name="header" style="flex-grow: 0; height: 40px; flex-basis: auto; position: relative; flex-direction: row; flex-shrink: 1; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(31, 33, 38); padding-bottom: 2px; padding-top: 2px;">
        <ui:VisualElement name="buffer" class="bar-element" style="flex-grow: 1;" />
        <ui:Label text="temp or smth" style="align-self: center; margin-top: 9px; margin-right: 16px; margin-bottom: 9px; margin-left: 16px; -unity-text-align: upper-right;" />
        <ui:Button text="Save &amp; Rebuild" name="save" class="bar-button" />
    </ui:VisualElement>
    <ui:VisualElement name="working-area" style="flex-grow: 1; flex-direction: row-reverse; background-color: rgb(52, 50, 60); height: 800px;">
        <ui:VisualElement name="grid" style="flex-grow: 1;" />
        <ui:VisualElement name="tools" class="drawer-default" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; flex-grow: 0; width: 200px;">
            <ui:VisualElement name="inspector" class="drawer-default dispose-cells" style="flex-grow: 1;" />
            <ui:VisualElement name="CellDrawer" class="drawer-default dispose-cells" style="flex-grow: 1; flex-direction: column; justify-content: center; align-self: center; width: 100%; align-content: center;">
                <ui:Instance template="cell-default" name="dialogue" class="cell-source" style="width: 120px; height: 60px; align-self: center;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
